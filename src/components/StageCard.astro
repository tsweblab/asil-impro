---
import { formatDateLongue, type Stage } from '../lib/keystatic';
import EntryExtras from './EntryExtras.astro';

interface Props {
  stage: Stage;
  index?: number;
  labels?: { horaires: string; lieu: string; intervenant: string; tarif: string; bouton: string; du: string; au: string; imageFallback: string };
}

const { stage, index = 0, labels = { horaires: 'Horaires :', lieu: 'Lieu :', intervenant: 'Intervenant·e :', tarif: 'Tarif :', bouton: "S'inscrire", du: 'Du', au: 'au', imageFallback: 'ASIL' } } = Astro.props;

const periode = stage.dateFin
  ? `${labels.du} ${formatDateLongue(stage.dateDebut!).toLowerCase()} ${labels.au} ${formatDateLongue(stage.dateFin).toLowerCase()}`
  : formatDateLongue(stage.dateDebut!);
---

<div class="scroll-reveal scroll-reveal--stage h-full" style={`--reveal-order:${index};`}>
  <article class="card-scene card-hover grid h-full gap-6 overflow-hidden md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
    {stage.image ? (
      <img
        src={stage.image}
        alt={stage.imageAlt || `Stage : ${stage.titre}`}
        class:list={['w-full bg-black/30', stage.imageFit === 'auto' ? 'h-auto self-start object-contain' : 'h-full min-h-48', stage.imageFit === 'contain' ? 'object-contain' : stage.imageFit !== 'auto' ? 'object-cover' : '']}
        loading="lazy"
      />
    ) : (
      <div class="grid min-h-48 place-items-center bg-gradient-to-br from-asil-red to-asil-red-dark" aria-hidden="true">
        <span class="font-display text-6xl font-bold italic text-white/85">{labels.imageFallback}</span>
      </div>
    )}
    <div class="flex flex-col gap-3 p-6 md:py-8 md:pr-8 md:pl-0">
      <p class="font-sans text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-asil-red-light">{periode}</p>
      <h3 class="text-2xl text-white">{stage.titre}</h3>
      <ul class="grid gap-1.5 text-sm text-white/75">
        {stage.horaires && <li><strong class="text-white">{labels.horaires}</strong> {stage.horaires}</li>}
        {stage.lieu && <li><strong class="text-white">{labels.lieu}</strong> {stage.lieu}</li>}
        {stage.intervenant && <li><strong class="text-white">{labels.intervenant}</strong> {stage.intervenant}</li>}
        {stage.tarif && <li><strong class="text-white">{labels.tarif}</strong> {stage.tarif}</li>}
      </ul>
      {stage.description && <p class="text-sm leading-relaxed text-white/70">{stage.description}</p>}
      <EntryExtras photos={stage.galeriePhotos} blocs={stage.blocsTexte} />
      {stage.lienInscription && (
        <a
          href={stage.lienInscription}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-red mt-auto self-start"
        >
          {labels.bouton}
        </a>
      )}
    </div>
  </article>
</div>
