---
import SocialLinks from './SocialLinks.astro';
import type { Telephone } from '../lib/keystatic';

interface Props {
  facebook: string;
  instagram: string;
  tiktok: string;
  logo: string;
  logoAlt: string;
  email: string;
  telephones: Telephone[];
  labels: {
    accueil: string; programme: string; stages: string; ateliers: string; contact: string; mentions: string;
    description: string; liensTitre: string; contactTitre: string; copyright: string; credit: string;
    creditNom: string; creditLien: string; siteNom: string;
  };
}

const { facebook, instagram, tiktok, logo, logoAlt, email, telephones, labels } = Astro.props;
const annee = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-white/8 bg-asil-black">
  <div class="pointer-events-none absolute inset-0 [background:radial-gradient(45rem_22rem_at_50%_-40%,rgba(227,6,19,0.08),transparent_60%)]" aria-hidden="true"></div>
  <!-- Watermark typographique géant (tendance oversized type) -->
  <p
    class="pointer-events-none absolute -bottom-[0.18em] left-1/2 -translate-x-1/2 select-none whitespace-nowrap font-display text-[clamp(6rem,20vw,18rem)] font-bold italic leading-none text-white/[0.035]"
    aria-hidden="true"
  >
    {labels.siteNom}
  </p>
  <div class="container-site grid gap-10 py-14 md:grid-cols-3">
    <div>
      <img
        src={logo}
        alt={logoAlt}
        width="140"
        height="62"
        class="h-14 w-auto"
        loading="lazy"
      />
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/60">
        {labels.description}
      </p>
    </div>

    <nav aria-label="Liens rapides" class="text-sm">
      <h2 class="mb-5 font-sans text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-white/55">{labels.liensTitre}</h2>
      <ul class="grid gap-2 text-white/70">
        <li><a href="/" class="transition-colors hover:text-asil-red">{labels.accueil}</a></li>
        <li><a href="/programme" class="transition-colors hover:text-asil-red">{labels.programme}</a></li>
        <li><a href="/stages" class="transition-colors hover:text-asil-red">{labels.stages}</a></li>
        <li><a href="/ateliers" class="transition-colors hover:text-asil-red">{labels.ateliers}</a></li>
        <li><a href="/contact" class="transition-colors hover:text-asil-red">{labels.contact}</a></li>
        <li><a href="/mentions-legales" class="transition-colors hover:text-asil-red">{labels.mentions}</a></li>
      </ul>
    </nav>

    <div class="text-sm">
      <h2 class="mb-5 font-sans text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-white/55">{labels.contactTitre}</h2>
      <ul class="grid gap-2 text-white/70">
        <li>
          <a href={`mailto:${email}`} class="font-semibold text-white transition-colors hover:text-asil-red">{email}</a>
        </li>
        {telephones.map((t) => (
          <li>
            <a href={`tel:${t.numero.replace(/[\s.]/g, '')}`} class="transition-colors hover:text-asil-red">{t.numero}</a>
            {t.libelle && <span class="text-white/45"> — {t.libelle}</span>}
          </li>
        ))}
      </ul>
      <SocialLinks facebook={facebook} instagram={instagram} tiktok={tiktok} siteNom={labels.siteNom} class="mt-5" />
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-site flex flex-col items-center justify-between gap-2 py-5 text-xs text-white/50 sm:flex-row">
      <p>© {annee} {labels.copyright}</p>
      <p>
        {labels.credit}
        <a
          href={labels.creditLien}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-white/80 transition-colors hover:text-asil-red"
        >
          {labels.creditNom}
        </a>
      </p>
    </div>
  </div>
</footer>
