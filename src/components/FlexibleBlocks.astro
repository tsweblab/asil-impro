---
import type { BlocLibre } from '../lib/keystatic';
import FadeInText from './motion/FadeInText.astro';
import ScaleIn from './motion/ScaleIn.astro';
import AnimatedButton from './motion/AnimatedButton.astro';

interface Props { blocs?: BlocLibre[]; }
const { blocs = [] } = Astro.props;
---

{blocs.map((bloc, index) => (
  <section class:list={[
    'container-site grid items-start gap-10 py-12 sm:py-16 lg:gap-12',
    bloc.image && (bloc.imagePosition === 'gauche'
      ? 'lg:grid-cols-[minmax(18rem,24rem)_minmax(0,1fr)]'
      : 'lg:grid-cols-[minmax(0,1fr)_minmax(18rem,24rem)]'),
    index > 0 && 'border-t border-white/14',
  ]}>
    {bloc.image && (
      <ScaleIn enhance={true} class:list={['w-full', bloc.imagePosition === 'gauche' ? 'lg:order-1 lg:justify-self-end' : 'lg:order-2 lg:justify-self-start']}>
        <img src={bloc.image} alt={bloc.imageAlt || ''} loading="lazy" class:list={['mx-auto max-h-[30rem] max-w-full rounded-2xl border border-white bg-black/30 shadow-2xl shadow-black/60', bloc.imageFit === 'auto' ? 'h-auto !w-auto object-contain' : 'aspect-[4/3] w-full', bloc.imageFit === 'contain' ? 'object-contain' : bloc.imageFit !== 'auto' ? 'object-cover' : '']} />
      </ScaleIn>
    )}
    <div class:list={[bloc.imagePosition === 'gauche' ? 'lg:order-2' : 'lg:order-1', bloc.image && 'lg:pt-8', !bloc.image && 'max-w-3xl']}>
      <FadeInText enhance={true} duration={0.7}>
        {bloc.surtitre && <p class="eyebrow mb-4">{bloc.surtitre}</p>}
        <h2 class="section-title text-4xl sm:text-5xl">{bloc.titre}</h2>
      </FadeInText>
      {bloc.texte && <p class="mt-6 whitespace-pre-line leading-relaxed text-white/80">{bloc.texte}</p>}
      {bloc.boutonTexte && bloc.boutonLien && <AnimatedButton variant="shimmer" href={bloc.boutonLien} class="btn-red mt-8">{bloc.boutonTexte}</AnimatedButton>}
    </div>
  </section>
))}
