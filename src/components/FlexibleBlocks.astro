---
import type { BlocLibre } from '../lib/keystatic';
import FadeInText from '@astroanimate/core/FadeInText';
import ScaleIn from '@astroanimate/core/ScaleIn';
import AnimatedButton from '@astroanimate/core/AnimatedButton';

interface Props { blocs?: BlocLibre[]; }
const { blocs = [] } = Astro.props;
---

{blocs.map((bloc, index) => (
  <section class:list={['container-site grid items-center gap-10 py-16 lg:grid-cols-2 lg:gap-16', index > 0 && 'border-t border-white/8']}>
    {bloc.image && (
      <ScaleIn enhance={true} class:list={[bloc.imagePosition === 'gauche' ? 'lg:order-1' : 'lg:order-2']}>
        <img src={bloc.image} alt={bloc.imageAlt || ''} loading="lazy" class="w-full rounded-2xl object-cover shadow-2xl shadow-black/60" />
      </ScaleIn>
    )}
    <div class:list={[bloc.imagePosition === 'gauche' ? 'lg:order-2' : 'lg:order-1', !bloc.image && 'lg:col-span-2 max-w-3xl']}>
      <FadeInText enhance={true} duration={0.7}>
        {bloc.surtitre && <p class="eyebrow mb-4">{bloc.surtitre}</p>}
        <h2 class="section-title text-4xl sm:text-5xl">{bloc.titre}</h2>
      </FadeInText>
      {bloc.texte && <p class="mt-6 whitespace-pre-line leading-relaxed text-white/80">{bloc.texte}</p>}
      {bloc.boutonTexte && bloc.boutonLien && <AnimatedButton variant="shimmer" href={bloc.boutonLien} class="btn-red mt-8">{bloc.boutonTexte}</AnimatedButton>}
    </div>
  </section>
))}
