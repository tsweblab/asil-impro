---
import SocialLinks from './SocialLinks.astro';

interface Props {
  facebook: string;
  instagram: string;
  logo: string;
  logoAlt: string;
  siteNom: string;
  telephone?: string;
  labels: { accueil: string; programme: string; stages: string; ateliers: string; contact: string };
}

const { facebook, instagram, logo, logoAlt, siteNom, telephone, labels } = Astro.props;
const telephoneHref = telephone ? telephone.replace(/[^\d+]/g, '') : '';

const liens = [
  { href: '/', label: labels.accueil },
  { href: '/programme', label: labels.programme },
  { href: '/stages', label: labels.stages },
  { href: '/ateliers', label: labels.ateliers },
];
---

<header data-site-header class="fixed inset-x-0 top-0 z-50 border-b border-white/8 bg-asil-night/85 shadow-[0_8px_30px_rgba(0,0,0,0.18)] backdrop-blur-xl">
  <div class="container-site flex items-center justify-between gap-6 py-3">
    <a href="/" aria-label={`${siteNom} — accueil`} class="shrink-0">
      <img
        src={logo}
        alt={logoAlt}
        width="120"
        height="53"
        class="h-11 w-auto"
      />
    </a>

    <!-- Nav desktop -->
    <nav aria-label="Navigation principale" class="hidden items-center gap-7 lg:flex" data-nav-links>
      {liens.map((lien) => (
        <a
          href={lien.href}
          class="relative font-sans text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-white/75 transition-colors duration-300 after:absolute after:-bottom-1.5 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-asil-red after:transition-transform after:duration-300 hover:text-white hover:after:scale-x-100 aria-[current=page]:text-white aria-[current=page]:after:scale-x-100"
        >
          {lien.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <SocialLinks facebook={facebook} instagram={instagram} siteNom={siteNom} />
      {telephone && (
        <a href={`tel:${telephoneHref}`} class="nav-phone-pill" aria-label={`Appeler l’ASIL au ${telephone}`}>
          <span class="nav-phone-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.33 1.84.56 2.8.69A2 2 0 0 1 22 16.92Z" />
            </svg>
          </span>
          <span>{telephone}</span>
        </a>
      )}
      <a href="/contact" class="btn-red min-h-10 px-5">{labels.contact}</a>
    </div>

    <!-- Bouton hamburger mobile -->
    <button
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="menu-mobile"
      aria-label="Ouvrir le menu"
      class="hamburger-button grid size-11 place-items-center rounded-xl border border-white/25 bg-white/[0.04] text-white shadow-lg shadow-black/20 transition hover:border-asil-red/70 hover:bg-asil-red/10 lg:hidden"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" class="size-6" aria-hidden="true">
        <path data-line="top" d="M4 7h16" />
        <path data-line="mid" d="M4 12h16" />
        <path data-line="bot" d="M4 17h16" />
      </svg>
    </button>
  </div>

  <!-- Menu mobile (slide) -->
  <nav
    id="menu-mobile"
    aria-label="Navigation mobile"
    aria-hidden="true"
    inert
    class="grid max-h-0 overflow-x-hidden overflow-y-auto border-t border-white/8 bg-asil-gray-dark/98 opacity-0 shadow-2xl shadow-black/50 transition-[max-height,opacity] duration-300 ease-out lg:hidden"
    data-menu-mobile
  >
    <div class="container-site flex flex-col gap-1 py-4">
      {liens.map((lien) => (
        <a
          href={lien.href}
          class="rounded-lg px-3 py-3 font-sans text-sm font-semibold uppercase tracking-[0.18em] text-white/80 transition-colors hover:bg-white/5 hover:text-white aria-[current=page]:text-asil-red"
        >
          {lien.label}
        </a>
      ))}
      {telephone && (
        <a href={`tel:${telephoneHref}`} class="nav-phone-pill mx-3 my-2 justify-center" aria-label={`Appeler l’ASIL au ${telephone}`}>
          <span class="nav-phone-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.33 1.84.56 2.8.69A2 2 0 0 1 22 16.92Z" />
            </svg>
          </span>
          <span>{telephone}</span>
        </a>
      )}
      <a href="/contact" class="btn-red mt-2">{labels.contact}</a>
      <SocialLinks facebook={facebook} instagram={instagram} siteNom={siteNom} class="mt-4 px-3 pb-2" />
    </div>
  </nav>
</header>

<!-- Cale sous la navbar fixe -->
<div aria-hidden="true" class="h-[68px]"></div>

<script>
  function initNavbar() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-menu-mobile]');
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!toggle || !menu || !header) return;

    const fermer = (rendreFocus = false) => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Ouvrir le menu');
      menu.setAttribute('aria-hidden', 'true');
      menu.inert = true;
      menu.style.maxHeight = '0';
      menu.classList.add('opacity-0');
      document.body.classList.remove('menu-mobile-open');
      document.documentElement.classList.remove('menu-mobile-open');
      if (rendreFocus) toggle.focus();
    };

    const ouvrir = () => {
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Fermer le menu');
      menu.setAttribute('aria-hidden', 'false');
      menu.inert = false;
      menu.classList.remove('opacity-0');
      const hauteurDisponible = Math.max(180, window.innerHeight - header.querySelector(':scope > div')!.getBoundingClientRect().height);
      menu.style.maxHeight = `${Math.min(menu.scrollHeight, hauteurDisponible)}px`;
      document.body.classList.add('menu-mobile-open');
      document.documentElement.classList.add('menu-mobile-open');
      menu.querySelector<HTMLElement>('a, button')?.focus();
    };

    if (!toggle.dataset.bound) {
      toggle.dataset.bound = 'true';
      toggle.addEventListener('click', () => {
        const ouvert = toggle.getAttribute('aria-expanded') === 'true';
        ouvert ? fermer() : ouvrir();
      });
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => fermer()));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') fermer(true);
        if (event.key === 'Tab' && toggle.getAttribute('aria-expanded') === 'true') {
          const focusables = [toggle, ...menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')];
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        }
      });
      document.addEventListener('pointerdown', (event) => {
        if (toggle.getAttribute('aria-expanded') === 'true' && !header.contains(event.target as Node)) fermer();
      });
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 1024) fermer();
        else if (toggle.getAttribute('aria-expanded') === 'true') ouvrir();
      });
    }

    // Lien actif : mis à jour à chaque navigation (la navbar persiste
    // entre les pages grâce à transition:persist).
    const chemin = location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll<HTMLAnchorElement>('header nav a').forEach((a) => {
      const cible = a.getAttribute('href')?.replace(/\/$/, '') || '/';
      if (cible === chemin) {
        a.setAttribute('aria-current', 'page');
      } else {
        a.removeAttribute('aria-current');
      }
    });

    fermer();
  }

  initNavbar();
  document.addEventListener('astro:page-load', initNavbar);
</script>

<style>
  [data-menu-mobile] {
    scrollbar-width: none;
  }

  [data-menu-mobile]::-webkit-scrollbar {
    display: none;
  }

  :global(html.menu-mobile-open),
  :global(body.menu-mobile-open) {
    overflow: hidden;
  }

  [data-line] {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 260ms ease, opacity 180ms ease;
  }

  .nav-phone-pill {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.34);
    border-radius: 999px;
    padding: 0.25rem 0.6rem 0.25rem 0.3rem;
    background: rgba(255, 255, 255, 0.07);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.09);
    font-family: var(--font-sans);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: white;
    transition: border-color 220ms ease, background-color 220ms ease, transform 220ms ease;
  }

  .nav-phone-pill:hover,
  .nav-phone-pill:focus-visible {
    border-color: rgba(255, 255, 255, 0.78);
    background: rgba(227, 6, 19, 0.16);
    transform: translateY(-1px);
  }

  .nav-phone-icon {
    display: grid;
    width: 1.4rem;
    height: 1.4rem;
    flex: none;
    place-items: center;
    border-radius: 999px;
    background: var(--color-asil-red);
    box-shadow: 0 5px 14px -7px rgba(227, 6, 19, 0.95);
  }

  .nav-phone-icon svg {
    width: 0.75rem;
    height: 0.75rem;
  }

  [aria-expanded="true"] [data-line="top"] {
    transform: translateY(5px) rotate(45deg);
  }

  [aria-expanded="true"] [data-line="mid"] {
    opacity: 0;
    transform: scaleX(0.25);
  }

  [aria-expanded="true"] [data-line="bot"] {
    transform: translateY(-5px) rotate(-45deg);
  }

  @media (min-width: 1024px) {
    :global(html.menu-mobile-open),
    :global(body.menu-mobile-open) {
      overflow: auto;
    }
  }
</style>
