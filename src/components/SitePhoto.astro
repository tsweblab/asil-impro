---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Photo remplaçable via Keystatic (« Paramètres du site ») :
 * si une image a été uploadée, on la sert telle quelle ; sinon on utilise
 * l'image par défaut du projet, optimisée par Astro (WebP + srcset).
 */
interface Props {
  publique?: string | null;
  fallback: ImageMetadata;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fit?: 'cover' | 'contain' | 'auto';
}

const {
  publique = null,
  fallback,
  alt,
  class: className,
  widths = [480, 800, 1200],
  sizes = '100vw',
  loading = 'lazy',
  fit = 'cover',
} = Astro.props;
const classes = [
  className,
  'border border-white/15 bg-black/20',
  fit === 'auto'
    ? 'mx-auto max-h-[30rem] max-w-full !w-auto object-contain'
    : 'aspect-[4/3]',
  fit === 'contain'
    ? 'object-contain bg-black/40'
    : fit === 'cover'
      ? 'object-cover'
      : '',
];
---

{publique ? (
  <img src={publique} alt={alt} class:list={classes} loading={loading} decoding="async" />
) : (
  <Image src={fallback} alt={alt} class:list={classes} widths={widths} sizes={sizes} loading={loading} />
)}
