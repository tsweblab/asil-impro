---
import CountUp from './motion/CountUp.astro';

interface Props { chiffres: readonly { readonly valeur: string; readonly libelle: string }[]; }
const { chiffres } = Astro.props;
const chiffresFormates = chiffres.map((chiffre) => {
  const correspondance = chiffre.valeur.trim().match(/^(\d+(?:[.,]\d+)?)(.*)$/);
  return {
    ...chiffre,
    nombre: correspondance ? Number(correspondance[1].replace(',', '.')) : null,
    suffixe: correspondance?.[2] ?? '',
  };
});
---

<section class="relative overflow-hidden border-y border-white/14 bg-asil-gray-dark" aria-label="Chiffres clés">
  <div class="pointer-events-none absolute inset-0 [background:radial-gradient(40rem_20rem_at_50%_120%,rgba(227,6,19,0.10),transparent_65%)]" aria-hidden="true"></div>
  <div class="container-site relative grid grid-cols-2 gap-8 py-16 sm:grid-cols-4">
    {chiffresFormates.map((c) => (
      <div class="border-t border-asil-red/60 pt-6">
        <p class="font-display text-5xl text-white sm:text-6xl">
          {c.nombre !== null ? (
            <CountUp
              value={c.nombre}
              suffix={c.suffixe}
              duration={1800}
            />
          ) : c.valeur}
        </p>
        <p class="mt-2 font-sans text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-white/70">{c.libelle}</p>
      </div>
    ))}
  </div>
</section>

<style>
  section :global(.count-up) {
    font-weight: 600;
  }
</style>
