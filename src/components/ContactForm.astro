---
const inputClass =
  'w-full rounded border border-white/20 bg-asil-gray-dark px-4 py-3 text-white placeholder:text-white/35 transition-colors duration-300 focus:border-asil-red focus:outline-none focus:ring-2 focus:ring-asil-red/40';

interface Props {
  textes: {
    nomLabel: string; nomPlaceholder: string; emailLabel: string; emailPlaceholder: string;
    sujetLabel: string; sujetPlaceholder: string; messageLabel: string; messagePlaceholder: string;
    boutonEnvoyer: string; boutonEnvoi: string; succesMessage: string; erreurMessage: string;
  };
}
const { textes } = Astro.props;
---

<form
  data-contact-form
  data-submit-text={textes.boutonEnvoyer}
  data-sending-text={textes.boutonEnvoi}
  data-success-text={textes.succesMessage}
  data-error-text={textes.erreurMessage}
  class="grid gap-5"
  novalidate
>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="nom" class="mb-2 block font-sans text-[0.7rem] font-semibold uppercase tracking-[0.2em]">{textes.nomLabel}</label>
      <input id="nom" name="nom" type="text" required autocomplete="name" placeholder={textes.nomPlaceholder} class={inputClass} />
    </div>
    <div>
      <label for="email" class="mb-2 block font-sans text-[0.7rem] font-semibold uppercase tracking-[0.2em]">{textes.emailLabel}</label>
      <input id="email" name="email" type="email" required autocomplete="email" placeholder={textes.emailPlaceholder} class={inputClass} />
    </div>
  </div>

  <div>
    <label for="sujet" class="mb-2 block font-sans text-[0.7rem] font-semibold uppercase tracking-[0.2em]">{textes.sujetLabel}</label>
    <input id="sujet" name="sujet" type="text" required placeholder={textes.sujetPlaceholder} class={inputClass} />
  </div>

  <div>
    <label for="message" class="mb-2 block font-sans text-[0.7rem] font-semibold uppercase tracking-[0.2em]">{textes.messageLabel}</label>
    <textarea id="message" name="message" required rows="6" placeholder={textes.messagePlaceholder} class={inputClass}></textarea>
  </div>

  <!-- Honeypot anti-spam : invisible pour les humains, rempli par les bots -->
  <div class="absolute -left-[9999px] size-px overflow-hidden" aria-hidden="true">
    <label for="website">Ne pas remplir ce champ</label>
    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <button type="submit" class="btn-red justify-self-start px-9" data-submit>
    {textes.boutonEnvoyer}
  </button>

  <p data-feedback role="status" aria-live="polite" class="hidden rounded border px-4 py-3 text-sm font-semibold"></p>
</form>

<script>
  function initContactForm() {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = 'true';

    const feedback = form.querySelector<HTMLElement>('[data-feedback]')!;
    const bouton = form.querySelector<HTMLButtonElement>('[data-submit]')!;

    const afficher = (message: string, ok: boolean) => {
      feedback.textContent = message;
      feedback.classList.remove('hidden');
      feedback.classList.toggle('border-green-500/50', ok);
      feedback.classList.toggle('bg-green-500/10', ok);
      feedback.classList.toggle('text-green-400', ok);
      feedback.classList.toggle('border-asil-red/60', !ok);
      feedback.classList.toggle('bg-asil-red/10', !ok);
      feedback.classList.toggle('text-asil-red', !ok);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      bouton.disabled = true;
      bouton.textContent = form.dataset.sendingText || 'Envoi en cours…';

      try {
        const reponse = await fetch('/api/contact', {
          method: 'POST',
          body: new FormData(form),
        });
        const data = await reponse.json();

        if (reponse.ok && data.ok) {
          afficher(form.dataset.successText || 'Merci ! Votre message a bien été envoyé.', true);
          form.reset();
        } else {
          afficher(data.error ?? form.dataset.errorText ?? "Une erreur est survenue.", false);
        }
      } catch {
        afficher(form.dataset.errorText || "Impossible d'envoyer le message.", false);
      } finally {
        bouton.disabled = false;
        bouton.textContent = form.dataset.submitText || 'Envoyer le message';
      }
    });
  }

  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>
