---
import ScaleIn from './motion/ScaleIn.astro';
import type { Atelier } from '../lib/keystatic';
import EntryExtras from './EntryExtras.astro';

interface Props {
  atelier: Atelier;
  index?: number;
  labels?: { lieu: string; tarif: string };
}

const { atelier, index = 0, labels = { lieu: 'Lieu :', tarif: 'Tarif annuel :' } } = Astro.props;
---

<ScaleIn enhance={true} delay={index * 120} class="h-full">
  <article class="card-scene card-hover flex h-full flex-col gap-4 p-7">
    {atelier.image && (
      <img
        src={atelier.image}
        alt={atelier.imageAlt || `Atelier : ${atelier.titre}`}
        class:list={['-mx-7 -mt-7 mb-2 w-[calc(100%+3.5rem)] rounded-t-2xl bg-black/30', atelier.imageFit === 'auto' ? 'h-auto object-contain' : 'aspect-[16/9]', atelier.imageFit === 'contain' ? 'object-contain' : atelier.imageFit !== 'auto' ? 'object-cover' : '']}
        loading="lazy"
      />
    )}
    <h3 class="text-2xl text-white">{atelier.titre}</h3>
    {atelier.creneaux && (
      <div class="border-l-4 border-asil-red pl-4 text-sm leading-relaxed text-white/85 whitespace-pre-line">{atelier.creneaux}</div>
    )}
    <ul class="grid gap-1.5 text-sm text-white/75">
      {atelier.lieu && <li><strong class="text-white">{labels.lieu}</strong> {atelier.lieu}</li>}
      {atelier.tarif && <li><strong class="text-white">{labels.tarif}</strong> {atelier.tarif}</li>}
    </ul>
    {atelier.description && (
      <p class="text-sm leading-relaxed text-white/70">{atelier.description}</p>
    )}
    <EntryExtras photos={atelier.galeriePhotos} blocs={atelier.blocsTexte} />
  </article>
</ScaleIn>
