---
import type { Intervenant } from '../lib/keystatic';
interface Props { personne: Intervenant; index?: number; }
const { personne, index = 0 } = Astro.props;
---

<div class="scroll-reveal scroll-reveal--atelier-person h-full" style={`--reveal-turn:${index % 2 === 0 ? '-1deg' : '1deg'};`}>
  <article class="h-full overflow-hidden rounded-2xl border border-white bg-white shadow-[0_14px_36px_-28px_rgba(0,0,0,0.65)] transition-all duration-300 hover:-translate-y-1 hover:border-white hover:shadow-[0_20px_50px_-20px_rgba(0,0,0,0.25)]">
    {personne.image && <img src={personne.image} alt={personne.imageAlt || `Portrait de ${personne.nom}`} class:list={['w-full bg-black/10', personne.imageFit === 'auto' ? 'h-auto object-contain' : 'aspect-[4/3]', personne.imageFit === 'contain' ? 'object-contain' : personne.imageFit !== 'auto' ? 'object-cover' : '']} loading="lazy" />}
    <div class="p-6">
      <h3 class="text-2xl">{personne.nom}</h3>
      {personne.role && <p class="mt-1 text-xs font-semibold uppercase tracking-[0.18em] text-asil-red">{personne.role}</p>}
      <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-asil-gray">{personne.biographie}</p>
    </div>
  </article>
</div>
