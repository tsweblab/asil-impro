---
import SocialPostPreview from './SocialPostPreview.astro';

interface Photo {
  typeContenu?: 'photo' | 'publication';
  image: string | null;
  alt: string;
  legende?: string;
  lien?: string | null;
  imageFit?: 'cover' | 'contain' | 'auto';
}

interface Props {
  photos: Photo[];
  placeholderTexte?: string;
  lienTitre?: string;
  lienTexte?: string;
}
const { photos, lienTitre = 'Voir sur {reseau}', lienTexte = "L’aperçu n’est pas disponible, mais la publication reste accessible." } = Astro.props;
const mode = (photo: Photo) => photo.typeContenu ?? (photo.image ? 'photo' : photo.lien ? 'publication' : 'photo');
---

<div class="poster-carousel relative" data-photo-carousel role="region" aria-roledescription="carrousel" aria-label="Publications récentes">
  <ul class="poster-stack" role="list" data-poster-stack aria-live="polite" aria-atomic="false">
    {photos.map((photo, index) => (
      <li
        class="poster-card overflow-hidden rounded-3xl border border-white bg-asil-gray-dark"
        data-photo-card
        data-index={index}
        role="group"
        aria-roledescription="publication"
        aria-label={`${index + 1} sur ${photos.length} — ${photo.legende || photo.alt}`}
      >
        {mode(photo) === 'publication' && photo.lien ? (
          <SocialPostPreview url={photo.lien} titre={photo.legende || photo.alt} fallbackTitre={lienTitre} fallbackTexte={lienTexte} />
        ) : photo.image && photo.lien ? (
          <a href={photo.lien} target="_blank" rel="noopener noreferrer" class="block h-full">
            <img src={photo.image} alt={photo.alt} class:list={['size-full object-center', photo.imageFit === 'contain' || photo.imageFit === 'auto' ? 'object-contain bg-black' : 'object-cover']} loading="lazy" />
          </a>
        ) : photo.image ? (
          <img src={photo.image} alt={photo.alt} class:list={['size-full object-center', photo.imageFit === 'contain' || photo.imageFit === 'auto' ? 'object-contain bg-black' : 'object-cover']} loading="lazy" />
        ) : (
          <div class="size-full bg-black" aria-hidden="true"></div>
        )}
        {photo.image && photo.legende && mode(photo) === 'photo' && <p class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 to-transparent px-5 pb-4 pt-12 text-sm text-white">{photo.legende}</p>}
      </li>
    ))}
  </ul>
  {photos.length > 1 && (
    <div class="poster-navigation" aria-label="Navigation du carrousel">
      <button type="button" data-photo-prev aria-label="Publication précédente" class="poster-arrow poster-arrow--prev">
        <span class="poster-arrow-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="m14.5 5-7 7 7 7" /></svg>
        </span>
      </button>
      <div class="mt-4 flex items-center justify-center gap-2" data-photo-dots aria-label="Choisir une publication">
        {photos.map((_, index) => <button type="button" data-photo-dot data-index={index} aria-label={`Afficher l’élément ${index + 1}`} class="photo-carousel-dot"></button>)}
      </div>
      <button type="button" data-photo-next aria-label="Publication suivante" class="poster-arrow poster-arrow--next">
        <span class="poster-arrow-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="m9.5 5 7 7-7 7" /></svg>
        </span>
      </button>
    </div>
  )}
</div>

<script>
  function initPhotoCarousels() {
    document.querySelectorAll<HTMLElement>('[data-photo-carousel]').forEach((carousel) => {
      if (carousel.dataset.bound) return;
      carousel.dataset.bound = 'true';
      const stack = carousel.querySelector<HTMLElement>('[data-poster-stack]');
      if (!stack) return;
      const cards = [...carousel.querySelectorAll<HTMLElement>('[data-photo-card]')];
      const dots = [...carousel.querySelectorAll<HTMLButtonElement>('[data-photo-dot]')];
      let active = 0;

      const setActive = (index: number) => {
        active = (index + cards.length) % cards.length;
        cards.forEach((card, i) => {
          let offset = i - active;
          if (offset > cards.length / 2) offset -= cards.length;
          if (offset < -cards.length / 2) offset += cards.length;
          const distance = Math.abs(offset);
          card.style.setProperty('--poster-offset', String(offset));
          card.style.setProperty('--poster-distance', String(distance));
          card.style.setProperty('--poster-depth', String(cards.length - distance));
          card.classList.toggle('is-active', offset === 0);
          card.classList.toggle('is-hidden', distance > 2);
          card.setAttribute('aria-hidden', offset === 0 ? 'false' : 'true');
          card.inert = offset !== 0;
          card.querySelectorAll<HTMLElement>('iframe, a').forEach((interactive) => {
            interactive.tabIndex = offset === 0 ? 0 : -1;
          });
        });
        dots.forEach((dot, i) => {
          dot.classList.toggle('is-active', i === active);
          if (i === active) {
            dot.setAttribute('aria-current', 'true');
            dot.setAttribute('aria-disabled', 'true');
          } else {
            dot.removeAttribute('aria-current');
            dot.removeAttribute('aria-disabled');
          }
        });
      };

      const goTo = (index: number) => setActive(index);

      carousel.querySelector('[data-photo-prev]')?.addEventListener('click', () => goTo(active - 1));
      carousel.querySelector('[data-photo-next]')?.addEventListener('click', () => goTo(active + 1));
      dots.forEach((dot) => dot.addEventListener('click', () => goTo(Number(dot.dataset.index))));
      carousel.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(active - 1); }
        if (event.key === 'ArrowRight') { event.preventDefault(); goTo(active + 1); }
      });

      setActive(0);
    });
  }
  initPhotoCarousels();
  document.addEventListener('astro:page-load', initPhotoCarousels);
</script>
