---
import SocialPostPreview from './SocialPostPreview.astro';

interface Photo {
  typeContenu?: 'photo' | 'publication';
  image: string | null;
  alt: string;
  legende?: string;
  lien?: string | null;
}

interface Props { photos: Photo[]; }
const { photos } = Astro.props;
const mode = (photo: Photo) => photo.typeContenu ?? (photo.image ? 'photo' : photo.lien ? 'publication' : 'photo');
---

<div class="poster-carousel relative" data-photo-carousel role="region" aria-label="Publications récentes">
  <ul class="poster-stack" role="list" data-poster-stack>
    {photos.map((photo, index) => (
      <li
        class="poster-card overflow-hidden rounded-3xl border border-white/10 bg-asil-gray-dark"
        data-photo-card
        data-index={index}
        role="group"
        aria-roledescription="publication"
        aria-label={`${index + 1} sur ${photos.length} — ${photo.legende || photo.alt}`}
      >
        {mode(photo) === 'publication' && photo.lien ? (
          <SocialPostPreview url={photo.lien} titre={photo.legende || photo.alt} />
        ) : photo.image && photo.lien ? (
          <a href={photo.lien} target="_blank" rel="noopener noreferrer" class="block h-full">
            <img src={photo.image} alt={photo.alt} class="size-full object-cover" loading="lazy" />
          </a>
        ) : photo.image ? (
          <img src={photo.image} alt={photo.alt} class="size-full object-cover" loading="lazy" />
        ) : (
          <div class="grid size-full place-items-center bg-gradient-to-br from-asil-gray-dark to-asil-black px-8 text-center">
            <div>
              <span class="mx-auto grid size-14 place-items-center rounded-full border border-dashed border-asil-red/70 text-2xl text-asil-red" aria-hidden="true">+</span>
              <p class="mt-4 text-sm text-white/55">Photo à ajouter depuis Keystatic</p>
            </div>
          </div>
        )}
        {photo.legende && mode(photo) === 'photo' && <p class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 to-transparent px-5 pb-4 pt-12 text-sm text-white">{photo.legende}</p>}
      </li>
    ))}
  </ul>
  {photos.length > 1 && (
    <>
      <button type="button" data-photo-prev aria-label="Publication précédente" class="poster-arrow poster-arrow--prev"><span aria-hidden="true">←</span></button>
      <button type="button" data-photo-next aria-label="Publication suivante" class="poster-arrow poster-arrow--next"><span aria-hidden="true">→</span></button>
      <div class="mt-4 flex items-center justify-center gap-2" data-photo-dots aria-label="Choisir une publication">
        {photos.map((_, index) => <button type="button" data-photo-dot data-index={index} aria-label={`Afficher l’élément ${index + 1}`} class="photo-carousel-dot"></button>)}
      </div>
    </>
  )}
</div>

<script>
  function initPhotoCarousels() {
    document.querySelectorAll<HTMLElement>('[data-photo-carousel]').forEach((carousel) => {
      if (carousel.dataset.bound) return;
      carousel.dataset.bound = 'true';
      const stack = carousel.querySelector<HTMLElement>('[data-poster-stack]');
      if (!stack) return;
      const cards = [...carousel.querySelectorAll<HTMLElement>('[data-photo-card]')];
      const dots = [...carousel.querySelectorAll<HTMLButtonElement>('[data-photo-dot]')];
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let active = 0;
      let timer: number | undefined;
      let paused = false;

      const setActive = (index: number) => {
        active = (index + cards.length) % cards.length;
        cards.forEach((card, i) => {
          let offset = i - active;
          if (offset > cards.length / 2) offset -= cards.length;
          if (offset < -cards.length / 2) offset += cards.length;
          const distance = Math.abs(offset);
          card.style.setProperty('--poster-offset', String(offset));
          card.style.setProperty('--poster-distance', String(distance));
          card.style.setProperty('--poster-depth', String(cards.length - distance));
          card.classList.toggle('is-active', offset === 0);
          card.classList.toggle('is-hidden', distance > 2);
          card.setAttribute('aria-hidden', distance > 2 ? 'true' : 'false');
          card.querySelectorAll<HTMLElement>('iframe, a').forEach((interactive) => {
            interactive.tabIndex = offset === 0 ? 0 : -1;
          });
        });
        dots.forEach((dot, i) => {
          dot.classList.toggle('is-active', i === active);
          if (i === active) dot.setAttribute('aria-current', 'true'); else dot.removeAttribute('aria-current');
        });
      };

      const goTo = (index: number) => {
        setActive(index);
        restart();
      };

      const restart = () => {
        if (timer) window.clearInterval(timer);
        if (!paused && !reducedMotion && cards.length > 1) {
          timer = window.setInterval(() => goTo(active + 1), 5500);
        }
      };

      carousel.querySelector('[data-photo-prev]')?.addEventListener('click', () => goTo(active - 1));
      carousel.querySelector('[data-photo-next]')?.addEventListener('click', () => goTo(active + 1));
      dots.forEach((dot) => dot.addEventListener('click', () => goTo(Number(dot.dataset.index))));

      const pause = () => { paused = true; if (timer) window.clearInterval(timer); };
      const resume = () => { paused = false; restart(); };
      carousel.addEventListener('pointerenter', pause);
      carousel.addEventListener('pointerleave', resume);
      carousel.addEventListener('focusin', pause);
      carousel.addEventListener('focusout', (event) => {
        if (!carousel.contains((event as FocusEvent).relatedTarget as Node | null)) resume();
      });
      carousel.addEventListener('touchstart', pause, { passive: true });
      carousel.addEventListener('touchend', resume, { passive: true });

      setActive(0);
      restart();
    });
  }
  initPhotoCarousels();
  document.addEventListener('astro:page-load', initPhotoCarousels);
</script>
