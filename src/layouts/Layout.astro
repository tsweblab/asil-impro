---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getSettings } from '../lib/keystatic';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const settings = await getSettings();
const { title, description, ogImage = settings.imagePartage, structuredData } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(ogImage, Astro.site);
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: settings.siteNom,
  url: Astro.site?.toString(),
  logo: new URL(settings.logo, Astro.site).toString(),
  email: settings.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '26 rue Coraly-Royet',
    postalCode: '42100',
    addressLocality: 'Saint-Étienne',
    addressCountry: 'FR',
  },
  sameAs: [settings.facebook, settings.instagram, settings.tiktok].filter(Boolean),
};
const jsonLd = [organization, ...(Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : [])];
const safeJsonLd = JSON.stringify(jsonLd).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href={settings.favicon} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={settings.siteNom} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; frame-src https://www.instagram.com https://www.facebook.com https://www.tiktok.com https://www.youtube-nocookie.com; upgrade-insecure-requests" />
    <script type="application/ld+json" is:inline set:html={safeJsonLd}></script>

    <!-- Polices : Playfair Display (titres, serif théâtral) + Inter (corps) -->
    <ClientRouter />
  </head>
  <body class="grain">
    <a href="#contenu-principal" class="skip-link">Aller au contenu principal</a>
    <Navbar
      facebook={settings.facebook}
      instagram={settings.instagram}
      tiktok={settings.tiktok}
      logo={settings.logo}
      logoAlt={settings.logoAlt}
      siteNom={settings.siteNom}
      telephone={settings.telephones[0]?.numero}
      labels={{ accueil: settings.navAccueil, programme: settings.navProgramme, stages: settings.navStages, ateliers: settings.navAteliers, contact: settings.navContact }}
      transition:persist="navbar"
    />
    <main id="contenu-principal" tabindex="-1">
      <slot />
    </main>
    <Footer
      facebook={settings.facebook}
      instagram={settings.instagram}
      tiktok={settings.tiktok}
      logo={settings.logo}
      logoAlt={settings.logoAlt}
      email={settings.email}
      telephones={settings.telephones}
      labels={{
        accueil: settings.navAccueil, programme: settings.navProgramme, stages: settings.navStages,
        ateliers: settings.navAteliers, contact: settings.navContact, mentions: settings.navMentions, description: settings.footerDescription,
        liensTitre: settings.footerLiensTitre, contactTitre: settings.footerContactTitre,
        copyright: settings.footerCopyright, credit: settings.footerCredit,
        creditNom: settings.footerCreditNom, creditLien: settings.footerCreditLien, siteNom: settings.siteNom,
      }}
    />
  </body>
</html>
