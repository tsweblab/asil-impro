---
import FadeInText from '@astroanimate/core/FadeInText';
import ScaleIn from '@astroanimate/core/ScaleIn';
import AnimatedButton from '@astroanimate/core/AnimatedButton';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import EventCarousel from '../components/EventCarousel.astro';
import SectionChiffres from '../components/SectionChiffres.astro';
import SitePhoto from '../components/SitePhoto.astro';
import MarqueeBand from '../components/MarqueeBand.astro';
import PhotoCarousel from '../components/PhotoCarousel.astro';
import FlexibleBlocks from '../components/FlexibleBlocks.astro';
import { getSettings, getEvenementsAVenir, getHomePage } from '../lib/keystatic';
import maud from '../assets/maud.jpg';
import comediens from '../assets/comediens.jpg';

const settings = await getSettings();
const page = await getHomePage();
const aVenir = await getEvenementsAVenir();
const misEnAvant = aVenir.filter((e) => e.misEnAvant);
const prochains = (misEnAvant.length > 0 ? misEnAvant : aVenir).slice(0, 4);
---

<Layout title={page.seoTitre} description={page.seoDescription}>
  <Hero
    titre={settings.heroTitre}
    sousTitre={settings.heroSousTitre}
    description={page.heroDescription}
    boutonPrincipal={page.heroBoutonPrincipal}
    boutonPrincipalLien={page.heroBoutonPrincipalLien}
    boutonSecondaire={page.heroBoutonSecondaire}
    boutonSecondaireLien={page.heroBoutonSecondaireLien}
    imagePublique={settings.heroImage}
  />

  <MarqueeBand mots={page.marqueeMots.length ? page.marqueeMots : undefined} />

  {prochains.length > 0 && (
    <section class="container-site py-16 sm:py-20" aria-labelledby="prochainement">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow mb-4">{page.agendaSurtitre}</p>
          <h2 id="prochainement" class="section-title text-4xl sm:text-5xl">{page.agendaTitre}</h2>
        </div>
        <a href="/programme" class="group font-sans text-xs font-semibold uppercase tracking-[0.2em] text-asil-red transition-colors hover:text-white">
          {page.agendaLienTexte} <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
      </div>
      <EventCarousel evenements={prochains} boutonTexte={settings.evenementBouton} />
    </section>
  )}

  {page.galeriePhotos.length > 0 && (
    <section class="container-site py-16 sm:py-20" aria-labelledby="galerie-accueil">
      <FadeInText enhance={true} duration={0.7}>
        <p class="eyebrow mb-4">{page.galerieSurtitre}</p>
        <h2 id="galerie-accueil" class="section-title text-4xl sm:text-5xl">{page.galerieTitre}</h2>
      </FadeInText>
      {page.galerieDescription && <p class="mt-5 max-w-2xl leading-relaxed text-white/75">{page.galerieDescription}</p>}
      <div class="mt-10"><PhotoCarousel photos={page.galeriePhotos} /></div>
    </section>
  )}

  {page.raisons.length > 0 && (
    <section class="bg-asil-gray-light py-20 text-asil-black sm:py-28" aria-labelledby="pourquoi">
      <div class="container-site">
        <FadeInText enhance={true} duration={0.7}>
          <div class="mx-auto max-w-2xl text-center">
            <p class="eyebrow mb-4 justify-center before:hidden">{page.pourquoiSurtitre}</p>
            <h2 id="pourquoi" class="section-title centered text-4xl sm:text-5xl">{page.pourquoiTitre}</h2>
          </div>
        </FadeInText>
        <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {page.raisons.map((raison, i) => (
            <ScaleIn enhance={true} delay={i * 120} class="h-full">
              <article class="h-full rounded-2xl border border-black/5 bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:border-asil-red/30 hover:shadow-[0_20px_50px_-20px_rgba(0,0,0,0.25)]">
                <span class="grid size-13 place-items-center rounded-full bg-asil-red/10 text-asil-red" aria-hidden="true">✦</span>
                <h3 class="mt-6 text-xl text-asil-black">{raison.titre}</h3>
                <p class="mt-3 text-sm leading-relaxed text-asil-gray">{raison.texte}</p>
              </article>
            </ScaleIn>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="container-site grid items-center gap-10 py-16 sm:py-24 lg:grid-cols-2 lg:gap-16" aria-labelledby="rejoindre">
    <div>
      <FadeInText enhance={true} duration={0.7}>
        <p class="eyebrow mb-4">{page.rejoindreSurtitre}</p>
        <h2 id="rejoindre" class="section-title text-4xl sm:text-5xl">{page.rejoindreTitre}</h2>
      </FadeInText>
      <p class="mt-6 whitespace-pre-line leading-relaxed text-white/80">{page.rejoindreTexte}</p>
      <AnimatedButton variant="shimmer" href={page.rejoindreBoutonLien} class="btn-red mt-8 px-8">{page.rejoindreBouton}</AnimatedButton>
    </div>
    <ScaleIn enhance={true}>
      <SitePhoto publique={settings.photoRejoindre} fallback={maud} alt="Improvisatrice de l'ASIL sur scène" class="w-full rounded-2xl object-cover shadow-2xl shadow-black/60" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 34rem, 100vw" loading="lazy" />
    </ScaleIn>
  </section>

  {page.chiffres.length > 0 && <SectionChiffres chiffres={page.chiffres} />}

  <section class="container-site grid items-center gap-10 py-16 sm:py-24 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16" aria-labelledby="asil-quoi">
    <ScaleIn enhance={true} class="order-2 lg:order-1">
      <SitePhoto publique={settings.photoAsil} fallback={comediens} alt="Comédiens de l'ASIL en spectacle d'improvisation" class="w-full rounded-2xl object-cover shadow-2xl shadow-black/60" widths={[480, 800, 1365]} sizes="(min-width: 1024px) 30rem, 100vw" loading="lazy" />
    </ScaleIn>
    <div class="order-1 lg:order-2">
      <FadeInText enhance={true} duration={0.7}>
        <p class="eyebrow mb-4">{page.presentationSurtitre}</p>
        <h2 id="asil-quoi" class="section-title text-4xl sm:text-5xl">{page.presentationTitre}</h2>
      </FadeInText>
      <p class="mt-6 whitespace-pre-line leading-relaxed text-white/80">{page.presentationTexte}</p>
      {page.presentationCitation && <blockquote class="mt-7 border-l-2 border-asil-red pl-6 font-display text-2xl italic leading-snug text-white/90">{page.presentationCitation}</blockquote>}
    </div>
  </section>

  <FlexibleBlocks blocs={page.blocsLibres} />

  <section class="relative overflow-hidden bg-asil-red">
    <div class="pointer-events-none absolute inset-0 [background:radial-gradient(45rem_25rem_at_50%_-30%,rgba(255,255,255,0.18),transparent_60%)]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-0 [background:radial-gradient(40rem_20rem_at_50%_130%,rgba(0,0,0,0.35),transparent_65%)]" aria-hidden="true"></div>
    <div class="container-site relative flex flex-col items-center gap-6 py-20 text-center sm:py-28">
      <FadeInText enhance={true} duration={0.7}>
        <h2 class="max-w-3xl text-4xl text-white sm:text-6xl">{page.ctaTitre}</h2>
      </FadeInText>
      <p class="max-w-xl whitespace-pre-line leading-relaxed text-white/90">{page.ctaTexte}</p>
      <a href={page.ctaBoutonLien} class="btn mt-2 min-h-13 bg-white px-10 text-asil-red hover:bg-asil-black hover:text-white">{page.ctaBouton}</a>
    </div>
  </section>
</Layout>
