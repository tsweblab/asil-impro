---
import FadeInText from '../components/motion/FadeInText.astro';
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import SitePhoto from '../components/SitePhoto.astro';
import SocialLinks from '../components/SocialLinks.astro';
import FlexibleBlocks from '../components/FlexibleBlocks.astro';
import { getSettings, getContactPage, type BlocLibre } from '../lib/keystatic';
import scenePhoto from '../assets/scene-impro.jpg';

const settings = await getSettings();
const contenu = await getContactPage();
const page = {
  seoTitre: contenu?.seoTitre ?? 'Contact — ASIL Impro', seoDescription: contenu?.seoDescription ?? "Contactez l'ASIL Impro à Saint-Étienne.",
  surtitre: contenu?.surtitre ?? 'On vous répond vite', titre: contenu?.titre ?? 'Contact', introduction: contenu?.introduction ?? '',
  photoContact: contenu?.photoContact ?? null,
  photoContactFit: contenu?.photoContactFit ?? 'cover',
  photoContactAlt: contenu?.photoContactAlt ?? "Spectacle d'improvisation de l'ASIL",
  formulaireTitre: contenu?.formulaireTitre ?? 'Envoyez-nous un message',
  nomLabel: contenu?.nomLabel ?? 'Nom', nomPlaceholder: contenu?.nomPlaceholder ?? 'Votre nom',
  emailLabel: contenu?.emailLabel ?? 'Email', emailPlaceholder: contenu?.emailPlaceholder ?? 'votre@email.fr',
  sujetLabel: contenu?.sujetLabel ?? 'Sujet', sujetPlaceholder: contenu?.sujetPlaceholder ?? 'Inscription, réservation, question…',
  messageLabel: contenu?.messageLabel ?? 'Message', messagePlaceholder: contenu?.messagePlaceholder ?? 'Votre message…',
  boutonEnvoyer: contenu?.boutonEnvoyer ?? 'Envoyer le message', boutonEnvoi: contenu?.boutonEnvoi ?? 'Envoi en cours…',
  succesMessage: contenu?.succesMessage ?? 'Merci ! Votre message a bien été envoyé. Nous vous répondrons au plus vite.',
  erreurMessage: contenu?.erreurMessage ?? "Impossible d'envoyer le message. Vérifiez votre connexion ou écrivez-nous par email.",
  coordonneesTitre: contenu?.coordonneesTitre ?? 'Nos coordonnées', emailTitre: contenu?.emailTitre ?? 'Email',
  telephoneTitre: contenu?.telephoneTitre ?? 'Téléphone', ateliersTitre: contenu?.ateliersTitre ?? 'Ateliers',
  ateliersAdresse: contenu?.ateliersAdresse ?? 'Amicale Laïque Michelet\n26 rue Coraly-Royet, 42100 Saint-Étienne',
  reseauxTitre: contenu?.reseauxTitre ?? 'Réseaux sociaux',
  blocsLibres: (contenu?.blocsLibres ?? []).filter((bloc) => bloc.actif !== false) as BlocLibre[],
};
---

<Layout title={page.seoTitre} description={page.seoDescription}>
  <section class="container-site py-14 sm:py-20">
    <FadeInText duration={0.7}><p class="eyebrow mb-4">{page.surtitre}</p><h1 class="section-title text-5xl sm:text-6xl">{page.titre}</h1></FadeInText>
    <p class="mt-5 max-w-2xl whitespace-pre-line leading-relaxed text-white/75">{page.introduction}</p>
  </section>
  <section class="container-site grid gap-12 pb-20 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-16">
    <div><h2 class="mb-7 text-2xl">{page.formulaireTitre}</h2><ContactForm textes={page} /></div>
    <aside class="flex flex-col gap-8">
      <SitePhoto publique={page.photoContact} fallback={scenePhoto} alt={page.photoContactAlt} fit={page.photoContactFit} class="aspect-[4/3] w-full rounded-2xl shadow-2xl shadow-black/60" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 26rem, 100vw" loading="lazy" />
      <div class="card-scene p-8">
        <h2 class="text-2xl">{page.coordonneesTitre}</h2>
        <ul class="mt-5 grid gap-4 text-sm">
          <li><span class="block text-[0.65rem] font-semibold uppercase tracking-[0.25em] text-white/50">{page.emailTitre}</span><a href={`mailto:${settings.email}`} class="font-semibold text-white hover:text-asil-red">{settings.email}</a></li>
          {settings.telephones.length > 0 && <li><span class="block text-[0.65rem] font-semibold uppercase tracking-[0.25em] text-white/50">{page.telephoneTitre}</span>{settings.telephones.map((t) => <p><a href={`tel:${t.numero.replace(/[\s.]/g, '')}`} class="font-semibold text-white hover:text-asil-red">{t.numero}</a>{t.libelle && <span class="text-white/60"> — {t.libelle}</span>}</p>)}</li>}
          <li><span class="block text-[0.65rem] font-semibold uppercase tracking-[0.25em] text-white/50">{page.ateliersTitre}</span><p class="whitespace-pre-line text-white/80">{page.ateliersAdresse}</p></li>
          <li><span class="mb-2 block text-[0.65rem] font-semibold uppercase tracking-[0.25em] text-white/50">{page.reseauxTitre}</span><SocialLinks facebook={settings.facebook} instagram={settings.instagram} siteNom={settings.siteNom} /></li>
        </ul>
      </div>
    </aside>
  </section>
  <FlexibleBlocks blocs={page.blocsLibres} />
</Layout>
