---
import Layout from '../layouts/Layout.astro';
import { getMentionsPage } from '../lib/keystatic';

const contenu = await getMentionsPage();
const page = {
  seoTitre: contenu?.seoTitre ?? 'Mentions légales — ASIL Impro',
  seoDescription: contenu?.seoDescription ?? "Mentions légales du site de l'ASIL Impro.",
  titre: contenu?.titre ?? 'Mentions légales',
  sections: contenu?.sections ?? [],
};
---

<Layout title={page.seoTitre} description={page.seoDescription}>
  <section class="container-site max-w-3xl py-14 sm:py-20">
    <h1 class="section-title text-4xl">{page.titre}</h1>
    <div class="mt-10 grid gap-8 text-sm leading-relaxed text-white/80">
      {page.sections.map((section) => (
        <section>
          <h2 class="mb-2 text-lg text-white">{section.titre}</h2>
          <p class="whitespace-pre-line">{section.texte}</p>
          {section.lienTexte && section.lienUrl && <a href={section.lienUrl} class="font-semibold text-asil-red hover:underline">{section.lienTexte}</a>}
        </section>
      ))}
    </div>
  </section>
</Layout>
