---
import FadeInText from '../components/motion/FadeInText.astro';
import Layout from '../layouts/Layout.astro';
import StageCard from '../components/StageCard.astro';
import SitePhoto from '../components/SitePhoto.astro';
import FlexibleBlocks from '../components/FlexibleBlocks.astro';
import { getStages, getStagesPage, todayInParis, type BlocLibre } from '../lib/keystatic';
import stagePhoto from '../assets/stage-nb.jpg';

const stages = await getStages();
const contenu = await getStagesPage();
const today = todayInParis();
const aVenir = stages.filter((s) => (s.dateFin ?? s.dateDebut ?? '') >= today);
const page = {
  seoTitre: contenu?.seoTitre ?? "Stages d'improvisation — ASIL Impro",
  seoDescription: contenu?.seoDescription ?? "Stages d'improvisation théâtrale à Saint-Étienne.",
  surtitre: contenu?.surtitre ?? 'Une journée pour jouer', titre: contenu?.titre ?? 'Les stages',
  citation: contenu?.citation ?? '« Toi-même tu sais… »', introduction: contenu?.introduction ?? '',
  photoStages: contenu?.photoStages ?? null,
  photoStagesFit: contenu?.photoStagesFit ?? 'cover',
  photoStagesAlt: contenu?.photoStagesAlt ?? "Participants d'un stage d'improvisation de l'ASIL",
  conseil: contenu?.conseil ?? '', listeTitre: contenu?.listeTitre ?? 'Prochains stages',
  stageHorairesLabel: contenu?.stageHorairesLabel ?? 'Horaires :',
  stageLieuLabel: contenu?.stageLieuLabel ?? 'Lieu :',
  stageIntervenantLabel: contenu?.stageIntervenantLabel ?? 'Intervenant·e :',
  stageTarifLabel: contenu?.stageTarifLabel ?? 'Tarif :',
  stageBouton: contenu?.stageBouton ?? "S'inscrire",
  stageDuLabel: contenu?.stageDuLabel ?? 'Du',
  stageAuLabel: contenu?.stageAuLabel ?? 'au',
  stageImageFallback: contenu?.stageImageFallback ?? 'ASIL',
  videTitre: contenu?.videTitre ?? 'Les prochaines dates arrivent bientôt',
  videTexte: contenu?.videTexte ?? 'Le calendrier des stages de la saison est en préparation.',
  blocsLibres: (contenu?.blocsLibres ?? []).filter((bloc) => bloc.actif !== false) as BlocLibre[],
};
const structuredData = aVenir.map((stage) => ({
  '@context': 'https://schema.org',
  '@type': 'EducationEvent',
  name: stage.titre,
  startDate: stage.dateDebut,
  endDate: stage.dateFin ?? stage.dateDebut,
  description: stage.description,
  image: stage.image ? new URL(stage.image, Astro.site).toString() : undefined,
  location: stage.lieu ? { '@type': 'Place', name: stage.lieu, address: stage.lieu } : undefined,
  performer: stage.intervenant ? { '@type': 'Person', name: stage.intervenant } : undefined,
  offers: stage.lienInscription ? { '@type': 'Offer', url: stage.lienInscription, availability: 'https://schema.org/InStock' } : undefined,
}));
---

<Layout title={page.seoTitre} description={page.seoDescription} structuredData={structuredData}>
  <section class="container-site grid items-start gap-10 py-12 sm:py-16 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,24rem)] lg:gap-12">
    <div class="lg:pt-8">
      <FadeInText duration={0.7}><p class="eyebrow mb-4">{page.surtitre}</p><h1 class="section-title text-5xl sm:text-6xl">{page.titre}</h1></FadeInText>
      {page.citation && <blockquote class="mt-7 border-l-2 border-asil-red pl-6 font-display text-2xl italic text-white/90">{page.citation}</blockquote>}
      <p class="mt-5 whitespace-pre-line leading-relaxed text-white/80">{page.introduction}</p>
      {page.conseil && <p class="mt-4 whitespace-pre-line leading-relaxed text-white/80">{page.conseil}</p>}
    </div>
    <SitePhoto publique={page.photoStages} fallback={stagePhoto} alt={page.photoStagesAlt} fit={page.photoStagesFit} class="w-full rounded-2xl shadow-2xl shadow-black/60 lg:mx-0" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 24rem, 100vw" loading="eager" />
  </section>
  <section class="container-site pb-20" aria-labelledby="stages-a-venir">
    <h2 id="stages-a-venir" class="section-title mb-12 text-4xl sm:text-5xl">{page.listeTitre}</h2>
    {aVenir.length === 0 ? (
      <div class="card-scene p-10 text-center"><h3 class="text-2xl">{page.videTitre}</h3><p class="mt-3 whitespace-pre-line text-white/70">{page.videTexte}</p></div>
    ) : <div class="grid gap-8">{aVenir.map((stage, i) => <StageCard stage={stage} index={i} labels={{ horaires: page.stageHorairesLabel, lieu: page.stageLieuLabel, intervenant: page.stageIntervenantLabel, tarif: page.stageTarifLabel, bouton: page.stageBouton, du: page.stageDuLabel, au: page.stageAuLabel, imageFallback: page.stageImageFallback }} />)}</div>}
  </section>
  <FlexibleBlocks blocs={page.blocsLibres} />
</Layout>
