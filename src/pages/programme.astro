---
import FadeInText from '../components/motion/FadeInText.astro';
import Layout from '../layouts/Layout.astro';
import EventCard from '../components/EventCard.astro';
import FlexibleBlocks from '../components/FlexibleBlocks.astro';
import { eventMonthKey, getEvenements, getProgrammePage } from '../lib/keystatic';

const evenements = await getEvenements();
const page = await getProgrammePage();
const nomsMois = ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'];
const cleDate = (annee: number, mois: number) => `${annee}-${String(mois).padStart(2, '0')}`;
const ancre = (cle: string) => `mois-${cle}`;

const moisConfigures = page.mois.map((m) => ({
  annee: m.annee!,
  mois: Number(m.mois),
  cle: cleDate(m.annee!, Number(m.mois)),
  actif: m.actif !== false,
}));

const moisDerives = [...new Set(evenements.map((e) => {
  return eventMonthKey(e.date!);
}))].sort().map((cle) => {
  const [annee, mois] = cle.split('-').map(Number);
  return { annee, mois, cle };
});

const moisAffiches = (moisConfigures.length > 0
  ? moisConfigures.filter((mois) => mois.actif)
  : moisDerives
).sort((a, b) => a.cle.localeCompare(b.cle));
const sections = moisAffiches.map((m) => ({
  ...m,
  titre: `${nomsMois[m.mois - 1]} ${m.annee}`,
  evenements: evenements.filter((e) => eventMonthKey(e.date!) === m.cle),
}));
const structuredData = evenements.map((event) => ({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.titre,
  startDate: event.date,
  description: event.description,
  image: event.image ? new URL(event.image, Astro.site).toString() : undefined,
  location: event.lieu ? {
    '@type': 'Place',
    name: event.lieu,
    address: event.adresse ? { '@type': 'PostalAddress', streetAddress: event.adresse } : undefined,
  } : undefined,
  offers: event.lienReservation ? { '@type': 'Offer', url: event.lienReservation, availability: 'https://schema.org/InStock' } : undefined,
}));
---

<Layout title={page.seoTitre} description={page.seoDescription} structuredData={structuredData}>
  <section class="container-site py-14 sm:py-20">
    <FadeInText duration={0.7}>
      <p class="eyebrow mb-4">{page.surtitre}</p>
      <h1 class="section-title text-5xl sm:text-6xl">{page.titre}</h1>
    </FadeInText>
    <p class="mt-5 max-w-2xl whitespace-pre-line leading-relaxed text-white/75">{page.introduction}</p>

    {sections.length > 0 && (
      <nav aria-label="Aller à un mois" class="mt-8 flex flex-wrap gap-2">
        {sections.map((section) => (
          <a href={`#${ancre(section.cle)}`} class="rounded-full border border-white/20 px-5 py-2 font-sans text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-white/75 transition-all duration-300 hover:border-asil-red hover:bg-asil-red hover:text-white">
            {section.titre}
          </a>
        ))}
      </nav>
    )}
  </section>

  <section class="container-site pb-20">
    {sections.length === 0 && (
      <div class="card-scene p-10 text-center">
        <h2 class="text-2xl">{page.aucunEvenementTitre}</h2>
        <p class="mt-3 whitespace-pre-line text-white/70">{page.aucunEvenementTexte}</p>
      </div>
    )}

    <div class="grid gap-14">
      {sections.map((section) => (
        <section id={ancre(section.cle)} aria-label={section.titre} class="scroll-mt-24">
          <div class="mb-7 flex items-baseline gap-6">
            <h2 class="shrink-0 font-display text-3xl italic text-asil-red-light sm:text-4xl">{section.titre}</h2>
            <div class="h-px grow bg-gradient-to-r from-white/20 to-transparent" aria-hidden="true"></div>
          </div>
          {section.evenements.length > 0 ? (
            <div class="programme-ticket-grid">
              {section.evenements.map((e, index) => (
                <div
                  class="programme-ticket-grid-item"
                  data-programme-ticket
                  data-ticket-order={index}
                >
                  <EventCard evenement={e} boutonTexte={page.evenementBouton} />
                </div>
              ))}
            </div>
          ) : (
            <div class="card-scene p-8">
              <h3 class="text-xl">{page.moisVideTitre}</h3>
              <p class="mt-2 whitespace-pre-line text-sm text-white/70">{page.moisVideTexte}</p>
            </div>
          )}
        </section>
      ))}
    </div>
  </section>

  <FlexibleBlocks blocs={page.blocsLibres} />
</Layout>

<script>
  const clamp = (value: number) => Math.min(1, Math.max(0, value));
  let cleanupTicketGrid: (() => void) | undefined;

  function initTicketGrid() {
    cleanupTicketGrid?.();

    const root = document.documentElement;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const items = [...document.querySelectorAll<HTMLElement>('[data-programme-ticket]')];
    const controller = new AbortController();
    let frame = 0;

    const resetTicket = (item: HTMLElement) => {
      for (const property of ['--ticket-y', '--ticket-scale', '--ticket-opacity', '--ticket-brightness', '--ticket-saturate', '--ticket-tilt', '--ticket-turn']) {
        item.style.removeProperty(property);
      }
    };

    const updateTicketGrid = () => {
      frame = 0;

      if (reduceMotion.matches || items.length === 0) {
        root.classList.remove('ticket-grid-motion');
        items.forEach(resetTicket);
        return;
      }

      root.classList.add('ticket-grid-motion');
      const viewportHeight = window.innerHeight;
      const entryStart = viewportHeight * 0.94;
      const entryEnd = viewportHeight * 0.58;
      const columns = window.innerWidth >= 1024 ? 3 : window.innerWidth >= 640 ? 2 : 1;

      items.forEach((item) => {
        const rect = item.getBoundingClientRect();
        const order = Number(item.dataset.ticketOrder || 0);
        const column = order % columns;
        const stagger = column * Math.min(24, window.innerWidth * 0.018);
        const entry = clamp((entryStart - rect.top - stagger) / Math.max(1, entryStart - entryEnd));
        const rise = Math.min(92, viewportHeight * 0.11);
        const direction = column % 2 === 0 ? -1 : 1;
        item.style.setProperty('--ticket-y', `${(1 - entry) * rise}px`);
        item.style.setProperty('--ticket-scale', `${0.94 + (entry * 0.06)}`);
        item.style.setProperty('--ticket-opacity', `${0.16 + (entry * 0.84)}`);
        item.style.setProperty('--ticket-brightness', `${0.72 + (entry * 0.28)}`);
        item.style.setProperty('--ticket-saturate', `${0.76 + (entry * 0.24)}`);
        item.style.setProperty('--ticket-tilt', `${(1 - entry) * 3.5}deg`);
        item.style.setProperty('--ticket-turn', `${direction * (1 - entry) * 1.8}deg`);
      });
    };

    const requestUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(updateTicketGrid);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true, signal: controller.signal });
    window.addEventListener('resize', requestUpdate, { passive: true, signal: controller.signal });
    reduceMotion.addEventListener('change', requestUpdate, { signal: controller.signal });

    cleanupTicketGrid = () => {
      controller.abort();
      if (frame) window.cancelAnimationFrame(frame);
      root.classList.remove('ticket-grid-motion');
    };

    requestUpdate();
  }

  initTicketGrid();
  document.addEventListener('astro:page-load', initTicketGrid);
</script>
