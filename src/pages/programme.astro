---
import FadeInText from '../components/motion/FadeInText.astro';
import Layout from '../layouts/Layout.astro';
import EventCard from '../components/EventCard.astro';
import FlexibleBlocks from '../components/FlexibleBlocks.astro';
import { eventMonthKey, getEvenements, getProgrammePage } from '../lib/keystatic';

const evenements = await getEvenements();
const page = await getProgrammePage();
const nomsMois = ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'];
const cleDate = (annee: number, mois: number) => `${annee}-${String(mois).padStart(2, '0')}`;
const ancre = (cle: string) => `mois-${cle}`;

const moisConfigures = page.mois.map((m) => ({
  annee: m.annee!,
  mois: Number(m.mois),
  cle: cleDate(m.annee!, Number(m.mois)),
  actif: m.actif !== false,
}));

const moisDerives = [...new Set(evenements.map((e) => {
  return eventMonthKey(e.date!);
}))].sort().map((cle) => {
  const [annee, mois] = cle.split('-').map(Number);
  return { annee, mois, cle };
});

const moisAffiches = (moisConfigures.length > 0
  ? moisConfigures.filter((mois) => mois.actif)
  : moisDerives
).sort((a, b) => a.cle.localeCompare(b.cle));
const sections = moisAffiches.map((m) => ({
  ...m,
  titre: `${nomsMois[m.mois - 1]} ${m.annee}`,
  evenements: evenements.filter((e) => eventMonthKey(e.date!) === m.cle),
}));
const structuredData = evenements.map((event) => ({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.titre,
  startDate: event.date,
  description: event.description,
  image: event.image ? new URL(event.image, Astro.site).toString() : undefined,
  location: event.lieu ? {
    '@type': 'Place',
    name: event.lieu,
    address: event.adresse ? { '@type': 'PostalAddress', streetAddress: event.adresse } : undefined,
  } : undefined,
  offers: event.lienReservation ? { '@type': 'Offer', url: event.lienReservation, availability: 'https://schema.org/InStock' } : undefined,
}));
---

<Layout title={page.seoTitre} description={page.seoDescription} structuredData={structuredData}>
  <section class="container-site py-14 sm:py-20">
    <FadeInText duration={0.7}>
      <p class="eyebrow mb-4">{page.surtitre}</p>
      <h1 class="section-title text-5xl sm:text-6xl">{page.titre}</h1>
    </FadeInText>
    <p class="mt-5 max-w-2xl whitespace-pre-line leading-relaxed text-white/75">{page.introduction}</p>

    {sections.length > 0 && (
      <nav aria-label="Aller à un mois" class="mt-8 flex flex-wrap gap-2">
        {sections.map((section) => (
          <a href={`#${ancre(section.cle)}`} class="rounded-full border border-white/20 px-5 py-2 font-sans text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-white/75 transition-all duration-300 hover:border-asil-red hover:bg-asil-red hover:text-white">
            {section.titre}
          </a>
        ))}
      </nav>
    )}
  </section>

  <section class="container-site pb-20">
    {sections.length === 0 && (
      <div class="card-scene p-10 text-center">
        <h2 class="text-2xl">{page.aucunEvenementTitre}</h2>
        <p class="mt-3 whitespace-pre-line text-white/70">{page.aucunEvenementTexte}</p>
      </div>
    )}

    <div class="grid gap-14">
      {sections.map((section) => (
        <section id={ancre(section.cle)} aria-label={section.titre} class="scroll-mt-24">
          <div class="mb-7 flex items-baseline gap-6">
            <h2 class="shrink-0 font-display text-3xl italic text-asil-red-light sm:text-4xl">{section.titre}</h2>
            <div class="h-px grow bg-gradient-to-r from-white/20 to-transparent" aria-hidden="true"></div>
          </div>
          {section.evenements.length > 0 ? (
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {section.evenements.map((e) => <div class="scroll-reveal h-full"><EventCard evenement={e} boutonTexte={page.evenementBouton} /></div>)}
            </div>
          ) : (
            <div class="card-scene p-8">
              <h3 class="text-xl">{page.moisVideTitre}</h3>
              <p class="mt-2 whitespace-pre-line text-sm text-white/70">{page.moisVideTexte}</p>
            </div>
          )}
        </section>
      ))}
    </div>
  </section>

  <FlexibleBlocks blocs={page.blocsLibres} />
</Layout>
