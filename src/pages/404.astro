---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page introuvable — ASIL Impro" description="Cette page n’existe pas ou a été déplacée.">
  <section class="container-site grid min-h-[65vh] place-items-center py-20 text-center">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Erreur 404</p>
      <h1 class="section-title text-5xl sm:text-7xl">Cette scène est vide</h1>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-white/75">La page que vous cherchez n’existe plus, ou son adresse a changé.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-red px-8">Retour à l’accueil</a>
        <a href="/programme" class="btn border border-white/25 px-8 text-white hover:border-white/50">Voir le programme</a>
      </div>
    </div>
  </section>
</Layout>
