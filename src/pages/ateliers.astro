---
import FadeInText from '../components/motion/FadeInText.astro';
import AnimatedButton from '../components/motion/AnimatedButton.astro';
import Layout from '../layouts/Layout.astro';
import AtelierCard from '../components/AtelierCard.astro';
import SitePhoto from '../components/SitePhoto.astro';
import IntervenantCard from '../components/IntervenantCard.astro';
import FlexibleBlocks from '../components/FlexibleBlocks.astro';
import { getAteliers, getAteliersPage, getIntervenants, type BlocLibre } from '../lib/keystatic';
import atelierPhoto from '../assets/atelier-portrait.jpg';

const ateliers = (await getAteliers()).filter((atelier) => atelier.categorie === 'adultes');
const intervenants = await getIntervenants();
const contenu = await getAteliersPage();
const page = {
  seoTitre: contenu?.seoTitre ?? "Ateliers d'improvisation — ASIL Impro",
  seoDescription: contenu?.seoDescription ?? "Cours d'improvisation théâtrale à Saint-Étienne pour adultes.",
  surtitre: contenu?.surtitre ?? 'Tous les mardis et mercredis',
  titre: contenu?.titre ?? 'Les ateliers',
  citation: contenu?.citation ?? "« Qui vit sans folie n'est pas aussi sage qu'il le croit. »",
  introduction: contenu?.introduction ?? '',
  photoAteliers: contenu?.photoAteliers ?? null,
  photoAteliersFit: contenu?.photoAteliersFit ?? 'cover',
  photoAteliersAlt: contenu?.photoAteliersAlt ?? "Atelier d'improvisation de l'ASIL",
  lieuTexte: contenu?.lieuTexte ?? '',
  boutonTexte: contenu?.boutonTexte ?? 'Demander une inscription',
  boutonLien: contenu?.boutonLien ?? '/contact',
  adultesTitre: contenu?.adultesTitre ?? 'Adultes',
  adultesIntroduction: contenu?.adultesIntroduction ?? '',
  atelierLieuLabel: contenu?.atelierLieuLabel ?? 'Lieu :',
  atelierTarifLabel: contenu?.atelierTarifLabel ?? 'Tarif annuel :',
  aucunAtelierTexte: contenu?.aucunAtelierTexte ?? 'Les prochains créneaux seront bientôt annoncés.',
  intervenantsSurtitre: contenu?.intervenantsSurtitre ?? 'Ils et elles vous accompagnent',
  intervenantsTitre: contenu?.intervenantsTitre ?? 'Les intervenant·es',
  blocsLibres: (contenu?.blocsLibres ?? []).filter((bloc) => bloc.actif !== false) as BlocLibre[],
};
---

<Layout title={page.seoTitre} description={page.seoDescription}>
  <section class="container-site grid items-start gap-10 py-12 sm:py-16 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,24rem)] lg:gap-12">
    <div class="lg:pt-8">
      <FadeInText duration={0.7}>
        <p class="eyebrow mb-4">{page.surtitre}</p>
        <h1 class="section-title text-5xl sm:text-6xl">{page.titre}</h1>
      </FadeInText>
      {page.citation && <blockquote class="mt-7 border-l-2 border-asil-red pl-6 font-display text-2xl italic text-white/90">{page.citation}</blockquote>}
      <p class="mt-5 whitespace-pre-line leading-relaxed text-white/80">{page.introduction}</p>
      {page.lieuTexte && <p class="mt-4 whitespace-pre-line leading-relaxed text-white/80">{page.lieuTexte}</p>}
      <AnimatedButton variant="shimmer" href={page.boutonLien} class="btn-red mt-8 px-8">{page.boutonTexte}</AnimatedButton>
    </div>
    <SitePhoto publique={page.photoAteliers} fallback={atelierPhoto} alt={page.photoAteliersAlt} fit={page.photoAteliersFit} class="w-full rounded-2xl shadow-2xl shadow-black/60 lg:mx-0" widths={[480, 800, 1000]} sizes="(min-width: 1024px) 24rem, 100vw" loading="eager" />
  </section>

  <section class="container-site pb-16" aria-labelledby="ateliers-adultes">
    <div class="mb-7 flex items-baseline gap-6">
      <h2 id="ateliers-adultes" class="shrink-0 font-display text-3xl italic text-asil-red-light sm:text-4xl">{page.adultesTitre}</h2>
      <div class="h-px grow bg-gradient-to-r from-white/20 to-transparent" aria-hidden="true"></div>
    </div>
    {page.adultesIntroduction && <p class="mb-8 max-w-2xl whitespace-pre-line text-white/70">{page.adultesIntroduction}</p>}
    {ateliers.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-white/20 bg-asil-gray-dark/60 p-8"><p class="whitespace-pre-line text-white/75">{page.aucunAtelierTexte}</p></div>
    ) : (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">{ateliers.map((atelier, i) => <AtelierCard atelier={atelier} index={i} labels={{ lieu: page.atelierLieuLabel, tarif: page.atelierTarifLabel }} />)}</div>
    )}
  </section>

  {intervenants.length > 0 && (
    <section class="bg-asil-gray-light py-20 text-asil-black sm:py-24" aria-labelledby="intervenants">
      <div class="container-site">
        <p class="eyebrow mb-4 !text-asil-red">{page.intervenantsSurtitre}</p>
        <h2 id="intervenants" class="section-title text-4xl sm:text-5xl">{page.intervenantsTitre}</h2>
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">{intervenants.map((personne) => <IntervenantCard personne={personne} />)}</div>
      </div>
    </section>
  )}

  <FlexibleBlocks blocs={page.blocsLibres} />
</Layout>
